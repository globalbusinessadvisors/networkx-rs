# GitHub Linguist configuration for language detection

# Primary language: Rust
*.rs linguist-language=Rust

# Secondary files
*.toml linguist-language=TOML
*.py linguist-language=Python

# Documentation
*.md linguist-documentation

# Vendored/Generated files (don't count toward language stats)
Makefile linguist-vendored
*.lock linguist-generated
*.so linguist-generated
*.pyc linguist-generated
__pycache__/* linguist-generated

# Test files are supplementary
test_*.py linguist-vendored
# Force GitHub to recognize this as a Rust project
*.rs linguist-language=Rust
*.toml linguist-language=TOML

# Documentation
*.md linguist-documentation

# Python bindings are secondary - they're just wrappers
python/**/*.py linguist-vendored
*.py linguist-vendored

# Ignore build artifacts and configs for language stats
Makefile linguist-vendored
target/* linguist-vendored
*.lock linguist-generated